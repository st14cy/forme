
---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
    variant?: "default" | "nav";
    href: string;
}

const {
    variant = "default",
    href,
    class: className = "",
    ...rest
} = Astro.props;

const normalizePath = (path: string) =>
    path.replace(/\/+$/, "") || "/";

const pathname = normalizePath(Astro.url.pathname);
const linkPath = normalizePath(href.split(/[?#]/)[0]);

const isActive =
    linkPath === "/"
        ? pathname === "/"
        : pathname === linkPath ||
        pathname.startsWith(`${linkPath}/`);
---

<a
        href={href}
        aria-current={isActive ? "page" : undefined}
        class:list={[
            "inline-flex items-center uppercase",

            "pt-5 pb-5 pr-3.5 pl-5 text-[14px]",
            "md:pt-5 md:pb-5 md:pr-3.5 md:pl-6",
            "lg:pt-5 lg:pb-7 lg:pr-3.5 lg:pl-6 lg:text-[20px]",

            {
                "font-semibold": variant === "default",
                "font-normal": variant === "nav",
            },

            {
                "text-acidlime": isActive,
                "text-ink hover:text-acidlime": !isActive,
            },

            className,
        ]}
        {...rest}
>
    <slot />
</a>
