---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
    variant?: "black" | "lime" | "outline";
}

const {
    variant = "black",
    class: className = "",
    ...rest
} = Astro.props;
---

<button
        type="button"
        class:list={[
            "inline-flex items-center justify-center",
            "pt-5 pb-5 pr-3.5 pl-5 text-[14px] uppercase ",
            "md:pt-5 md:pb-5 md:pr-3.5 md:pl-6",
            "lg:pt-5 lg:pb-7 lg:pr-3.5 lg:pl-6 lg:text-[20px] ",
            {
                "bg-ink text-white hover:bg-electricblue pressed:bg-acidlime": variant === "black",
                "bg-acidlime text-ink": variant === "lime",
                "border-y border-y-[1px] border-ink text-ink": variant === "outline",
            },
            className,
        ]}
        {...rest}
>
    <slot />
</button>