
---
import Link from "../common/Link.astro";

const naviation=[
    { title: "Проекты", href: "/catalog" },
    { title: "О нас", href: "/about" },
    { title: "Контакты", href: "/contacts" },
]
---



<nav  aria-label="Основная навигация" class="hidden items-center gap-10.5 lg:gap-12.5 text-[12px] md:flex">
    <ul class="flex items-center text-[12px] lg:text-[13px] gap-10.75 lg:gap-12.75 font-medium">
        {naviation.map((item) => (
                <li >
                    <Link href={item.href} variant="nav">
                        {item.title}
                    </Link>
                </li>
        ))}
    </ul>
</nav>



<details class="md:hidden">
    <summary class="flex cursor-pointer items-center">
        <span aria-hidden="true">☰</span>
        Меню
    </summary>

    <nav aria-label="Основная навигация">
        <ul class="flex items-center">
            {naviation.map((item) => (
                    <li>
                        <Link href={item.href} variant="nav">
                            {item.title}
                        </Link>
                    </li>
            ))}
        </ul>
    </nav>
</details>